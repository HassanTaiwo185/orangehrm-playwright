{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "description": "Cross-browser BDD Playwright E2E framework for OrangeHRM",
  "scripts": {
    "test": "cucumber-js --config cucumber.config.js --tags 'not @requiresLocalEnv and not @knownDefect'",
    "test:chrome": "BROWSER=chromium cucumber-js --config cucumber.config.js --tags 'not @requiresLocalEnv and not @knownDefect'",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.config.js --tags 'not @requiresLocalEnv and not @knownDefect'",
    "test:edge": "BROWSER=msedge cucumber-js --config cucumber.config.js --tags 'not @requiresLocalEnv and not @knownDefect'",
    "test:tags": "cucumber-js --config cucumber.config.js --tags",
    "test:all": "cucumber-js --config cucumber.config.js",
    "test:crossbrowser": "npm run test:chrome && npm run test:firefox",
     "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.12",
    "allure-commandline": "^2.29.0",
    "allure-cucumberjs": "^3.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
